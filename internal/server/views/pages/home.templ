package pages

templ Home() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Laretz</title>
			<link rel="stylesheet" href="/static/css/pico.min.css"/>
		</head>
		<body>
			<main class="container">
				<h1>Laretz</h1>
				<p>A single-user crypto portfolio tracker. Record Buy/Sell Operations and value your Portfolios using market data from pluggable sources.</p>
				<a href="/settings">Settings</a>
			</main>
		</body>
	</html>
}
