package components

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect width='16' height='16' rx='4' fill='%234f46e5'/%3E%3Cpath d='M4 10.5 6.5 8l2 2L12 5.5' stroke='white' stroke-width='1.5' fill='none' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E"/>
			<link rel="stylesheet" href="/static/css/pico.min.css"/>
			<link rel="stylesheet" href="/static/css/app.css"/>
		</head>
		<body>
			<header class="app-header">
				<div class="container app-header-inner">
					<a class="app-brand" href="/">Laretz</a>
					<span class="app-tagline">crypto portfolio tracker</span>
				</div>
			</header>
			<main class="container">
				{ children... }
			</main>
			<footer class="app-footer">
				<div class="container">Laretz — single-user crypto portfolio tracker</div>
			</footer>
			<script>document.addEventListener('click',function(e){var d=e.target.closest('[data-dialog]');if(d)document.getElementById(d.dataset.dialog).showModal()})</script>
		</body>
	</html>
}
